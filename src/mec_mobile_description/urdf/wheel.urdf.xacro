<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:macro name="wheel"
              params="wheel_name x y z">

  <!-- LINK -->
  <link name="${wheel_name}">

    <visual>

      <origin xyz="0 0 0"
              rpy="0 0 0"/>

      <geometry>

        <mesh filename="file://$(find mec_mobile_description)/meshes/wheel.stl" 
              scale="0.001 0.001 0.001"/>

      </geometry>

    </visual>

    <collision>
             
      <!-- Xoay 90 do quanh X de truc cylinder trung voi truc Y -->
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
            <cylinder radius="0.08" length="0.04"/>
        </geometry>
    </collision>

  <inertial>
      <mass value="6.0"/>
      <!-- cylinder: radius=0.08m, length=0.04m, trục quay y -->
      <!-- ixx=iyy = (1/12)*m*(3r²+l²) = (1/12)*6*(3*0.0064+0.0016) = 0.0106 -->
      <!-- izz = (1/2)*m*r² = 0.5*6*0.0064 = 0.0192 -->
      <origin xyz="0 0 0"/>
      <inertia
          ixx="0.0106"
          ixy="0.0"
          ixz="0.0"
          iyy="0.0192"
          iyz="0.0"
          izz="0.0106"/>
  </inertial>

  </link>

  <!-- JOINT -->
  <joint name="${wheel_name}_joint"
         type="continuous">

    <parent link="base_link"/>

    <child link="${wheel_name}"/>

    <origin xyz="${x} ${y} ${z}"
            rpy="0 0 0"/>

    <!-- ROS wheel axis -->
    <axis xyz="0 1 0"/>

  </joint>

</xacro:macro>

</robot>