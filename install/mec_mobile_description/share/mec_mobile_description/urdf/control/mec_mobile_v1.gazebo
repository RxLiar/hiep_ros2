<?xml version="1.0"?>
<robot>
    <gazebo>
        <plugin filename="gz-sim-diff-drive-system"
                name="gz::sim::systems::DiffDrive">
            <left_joint>left_drive_wheel_joint</left_joint>
            <right_joint>right_drive_wheel_joint</right_joint>
            <wheel_separation>0.50</wheel_separation>
            <wheel_radius>0.08</wheel_radius>
            <min_acceleration>-2.0</min_acceleration>
            <max_acceleration>2.0</max_acceleration>
            <max_linear_velocity>1.5</max_linear_velocity>
            <min_linear_velocity>-1.5</min_linear_velocity>
            <max_angular_velocity>0.5</max_angular_velocity>
            <min_angular_velocity>-0.5</min_angular_velocity>
            <topic>cmd_vel</topic>
            <odom_topic>odom</odom_topic>
            <tf_topic></tf_topic>  
            <frame_id>odom</frame_id>
            <child_frame_id>base_footprint</child_frame_id>
            <odom_publish_frequency>30</odom_publish_frequency>
        </plugin>

        <plugin filename="gz-sim-joint-state-publisher-system"
                name="gz::sim::systems::JointStatePublisher">
            <topic>joint_states</topic>
            <joint_name>left_drive_wheel_joint</joint_name>
            <joint_name>right_drive_wheel_joint</joint_name>
        </plugin>
    </gazebo>

    <!-- WHEEL FRICTION -->
    <gazebo reference="left_drive_wheel">
        <collision>
            <surface>
                <friction>
                    <ode>
                        <mu>2.0</mu>     <!-- tang tu 1.0 len 2.0 -->
                        <mu2>2.0</mu2>
                        <fdir1>1 0 0</fdir1>
                        <slip1>0.0</slip1>
                        <slip2>0.0</slip2>
                    </ode>
                    <torsional>
                        <coefficient>1.0</coefficient>
                        <use_patch_radius>true</use_patch_radius>
                        <patch_radius>0.08</patch_radius>
                    </torsional>
                </friction>
            </surface>
        </collision>
        <visual>
            <material>
                <ambient>0.05 0.05 0.05 1</ambient>
                <diffuse>0.1 0.1 0.1 1</diffuse>
                <specular>0.05 0.05 0.05 1</specular>
            </material>
        </visual>
    </gazebo>

    <gazebo reference="right_drive_wheel">
        <collision>
            <surface>
                <friction>
                    <ode>
                        <mu>2.0</mu>     <!-- tang tu 1.0 len 2.0 -->
                        <mu2>2.0</mu2>
                        <fdir1>1 0 0</fdir1>
                        <slip1>0.0</slip1>
                        <slip2>0.0</slip2>
                    </ode>
                    <torsional>
                        <coefficient>1.0</coefficient>
                        <use_patch_radius>true</use_patch_radius>
                        <patch_radius>0.08</patch_radius>
                    </torsional>
                </friction>
            </surface>
        </collision>
        <visual>
            <material>
                <ambient>0.05 0.05 0.05 1</ambient>
                <diffuse>0.1 0.1 0.1 1</diffuse>
                <specular>0.05 0.05 0.05 1</specular>
            </material>
        </visual>
    </gazebo>

    <!-- BASE COLOR -->
    <gazebo reference="base_link">
        <visual>
            <material>
                <script>
                    <uri>file://media/materials/scripts/gazebo.material</uri>
                    <name>Gazebo/Blue</name>
                </script>
                <ambient>0.1 0.1 0.5 1</ambient>
                <diffuse>0.1 0.1 0.8 1</diffuse>
                <specular>0.1 0.1 0.3 1</specular>
            </material>
        </visual>
    </gazebo>

    <!-- LIDAR COLOR -->
    <gazebo reference="front_lidar">
        <visual>
            <material>
                <ambient>0.8 0.1 0.1 1</ambient>
                <diffuse>0.8 0.1 0.1 1</diffuse>
                <specular>0.3 0.1 0.1 1</specular>
            </material>
        </visual>
    </gazebo>

    <gazebo reference="rear_lidar">
        <visual>
            <material>
                <ambient>0.8 0.1 0.1 1</ambient>
                <diffuse>0.8 0.1 0.1 1</diffuse>
                <specular>0.3 0.1 0.1 1</specular>
            </material>
        </visual>
    </gazebo>

    <!-- IMU COLOR -->
    <gazebo reference="imu_link">
        <visual>
            <material>
                <ambient>0.8 0.8 0.1 1</ambient>
                <diffuse>0.8 0.8 0.1 1</diffuse>
                <specular>0.3 0.3 0.1 1</specular>
            </material>
        </visual>
    </gazebo>

</robot>