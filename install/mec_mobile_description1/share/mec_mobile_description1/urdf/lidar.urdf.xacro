<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:macro name="lidar_link"
              params="lidar_name x y z roll pitch yaw">

  <link name="${lidar_name}">

    <visual>

      <geometry>

        <mesh filename="package://mec_mobile_description1/meshes/lidar.stl"
              scale="0.001 0.001 0.001"/>

      </geometry>

      <material name="blue">
        <color rgba="0.2 0.6 1.0 1.0"/>
      </material>

    </visual>

  </link>

  <joint name="${lidar_name}_joint"
         type="fixed">

    <parent link="base_link"/>

    <child link="${lidar_name}"/>

    <origin xyz="${x} ${y} ${z}"
            rpy="${roll} ${pitch} ${yaw}"/>

  </joint>

</xacro:macro>

</robot>