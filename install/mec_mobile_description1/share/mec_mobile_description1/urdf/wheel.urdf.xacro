<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:macro name="wheel"
              params="wheel_name x y z">

  <!-- LINK -->
  <link name="${wheel_name}">

    <visual>

      <origin xyz="0 0 0"
              rpy="0 0 0"/>

      <geometry>

        <mesh filename="package://mec_mobile_description1/meshes/wheel.stl"
              scale="0.001 0.001 0.001"/>

      </geometry>

    </visual>

    <collision>

      <origin xyz="0 0 0"/>

      <geometry>
        <cylinder radius="0.08"
                  length="0.04"/>
      </geometry>

    </collision>

    <inertial>

      <mass value="1.0"/>

      <origin xyz="0 0 0"/>

      <inertia
          ixx="0.01"
          ixy="0"
          ixz="0"
          iyy="0.01"
          iyz="0"
          izz="0.01"/>

    </inertial>

  </link>

  <!-- JOINT -->
  <joint name="${wheel_name}_joint"
         type="continuous">

    <parent link="base_link"/>

    <child link="${wheel_name}"/>

    <origin xyz="${x} ${y} ${z}"
            rpy="0 0 0"/>

    <!-- ROS wheel axis -->
    <axis xyz="0 1 0"/>

  </joint>

</xacro:macro>

</robot>