<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:macro name="base_link"
              params="">

  <link name="base_link">

    <!-- VISUAL -->
    <visual>

      <origin xyz="0 0 0"
              rpy="0 0 0"/>

      <geometry>
        <mesh filename="package://mec_mobile_description1/meshes/base.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="gray">
        <color rgba="0.0 0.6 0.6 1.0"/>
      </material>
    </visual>

    <!-- COLLISION -->
    <collision>

      <origin xyz="0 0 0"/>

      <geometry>
        <box size="1.8 0.7 1.45"/>
      </geometry>

    </collision>

    <!-- INERTIAL -->
    <inertial>

      <origin xyz="0 0 0"/>

      <mass value="25.0"/>

      <inertia
          ixx="1.0"
          ixy="0.0"
          ixz="0.0"
          iyy="1.0"
          iyz="0.0"
          izz="1.0"/>

    </inertial>

  </link>

</xacro:macro>

</robot>